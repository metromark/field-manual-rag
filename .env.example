# Copy to .env.local and fill in. Never commit real values.

# OpenAI — https://platform.openai.com/api-keys
# Used for chat (gpt-4o-mini) and embeddings (text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=

# Upstash Vector — https://console.upstash.com/vector
# Index settings: 1536 dimensions, COSINE metric, no built-in embedding model
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Which corpus in corpora/<id>/ the app serves (not a secret)
CORPUS_ID=fm21-76
